# Rizzr Backend — Required Environment Variables (set these in Railway Variables)
# ==============================================================================
# App
DEBUG=false

# CORS / host allowlists (comma-separated; keep swappable until final domain is locked)
# ALLOWED_ORIGINS=https://rizzr.com,https://www.rizzr.com,https://damgeed.github.io
# ALLOWED_HOSTS=rizzr.com,www.rizzr.com,api.rizzr.com,*.rizzr.com,*.up.railway.app

# --- Server-side secrets (NEVER commit these) ---
# OpenAI / Whisper
OPENAI_API_KEY=

# LLM (GLM via kaiweb gateway)
LLM_API_KEY=
# LLM_BASE_URL=https://ai.kaiweb.net/v1
# LLM_MODEL=glm-5.2

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Rate limiting (Redis; optional — falls back to in-memory per-instance)
# REDIS_URL=redis://default:...

# Cloudflare Tunnel (optional — if you want to hide the Railway origin)
# CLOUDFLARED_TUNNEL_TOKEN=
