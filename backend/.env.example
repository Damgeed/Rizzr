# Rizzr Backend — Required Environment Variables (set these in Railway Variables)
# ==============================================================================
# App
DEBUG=false

# CORS (add the live frontend origin that will call the API)
# GitHub Pages: https://damgeed.github.io is in the defaults.

# --- Server-side secrets (NEVER commit these) ---
# OpenAI / Whisper
OPENAI_API_KEY=

# LLM (GLM via kaiweb gateway)
LLM_API_KEY=
# LLM_BASE_URL=https://ai.kaiweb.net/v1
# LLM_MODEL=glm-5.2

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Stripe (live secrets — set from Stripe Dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=            # pro_monthly ($9.99/mo)
STRIPE_PRICE_ANNUAL_ID=     # pro_annual   ($7.99/mo billed yearly)
STRIPE_PRICE_PLUS_ID=       # pro_plus     ($19.99/mo decoy)

# Rate limiting (Redis; optional — falls back to in-memory per-instance)
# REDIS_URL=redis://default:...

# Cloudflare Tunnel (optional — if you want to hide the Railway origin)
# CLOUDFLARED_TUNNEL_TOKEN=
